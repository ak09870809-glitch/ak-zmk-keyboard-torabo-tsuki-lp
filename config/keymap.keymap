#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE    0
#define MOUSE   1
#define FN      2
#define NUM     3
#define SCROLL  4
#define M_MOUSE 5

&pointing_listener {
    input-processors = <
        &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
        &zip_temp_layer MOUSE 500
    >;

    scroller {
        layers = <SCROLL>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT) 
            &zip_xy_to_scroll_mapper
            &zip_scroll_scaler 1 2
        >;
    };
};

/ {
    behaviors {
        middle_layer: middle_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&mo>, <&kp>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&trans         &trans    &trans  &trans  &trans    &trans                          &trans       &trans    &trans     &trans    &trans    &trans
&kp ESC        &kp Q     &kp W   &kp E   &kp R     &kp T                           &kp Y        &kp U     &kp I      &kp O     &lt 4 P   &kp BSPC
&mt LCTRL TAB  &kp A     &kp S   &kp D   &kp F     &kp G        &trans     &trans  &kp H        &kp J     &kp K      &kp L     &kp SEMI  &mt RSHFT ENTER
&kp LSHFT      &kp Z     &kp X   &kp C   &kp V     &kp B        &kp B      &kp B   &kp N        &kp M     &kp COMMA  &kp DOT   &kp FSLH  &mt RSHFT UP
&kp CAPS       &kp LALT  &trans  &trans  &kp LGUI  &lt 4 LANG2  &kp SPACE  &mo 2   &lt 3 LANG1  &none     &none      &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans     &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &kp LC(X)  &mkp MB4  &mkp MB5  &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(C)  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(V)  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &to 0   &trans     &trans    &trans    &trans    &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans     &trans     &trans    &trans     &trans     &trans                     &trans    &trans    &trans    &trans   &trans     &trans
&kp GRAVE  &kp N1     &kp N2    &kp N3     &kp N4     &kp N5                     &kp N7    &kp N8    &kp N9    &kp N0   &kp MINUS  &kp EQUAL
&trans     &kp UP     &kp LEFT  &kp DOWN   &kp RIGHT  &kp N6  &trans     &trans  &kp LBKT  &kp RBKT  &kp SEMI  &kp SQT  &kp COLON  &trans
&trans     &kp PG_UP  &kp HOME  &kp PG_DN  &kp HOME   &kp N0  &kp N6     &kp N6  &trans    &trans    &trans    &trans   &trans     &trans
&trans     &trans     &trans    &trans     &trans     &trans  &kp LSHFT  &trans  &trans    &trans    &trans    &trans   &trans     &trans
            >;
        };

        layer_3 {
            bindings = <
&trans        &trans         &trans     &trans      &trans        &trans                                  &trans  &trans  &trans  &trans   &trans  &trans
&out OUT_USB  &kp KP_EQUAL   &kp KP_N7  &kp KP_N8   &kp KP_N9     &kp KP_MULTIPLY                         &trans  &trans  &trans  &trans   &trans  &trans
&bt BT_SEL 2  &kp KP_DIVIDE  &kp KP_N4  &kp KP_N5   &kp KP_N6     &kp KP_MINUS     &trans         &trans  &kp F7  &kp F8  &kp F9  &kp F10  &trans  &trans
&bt BT_SEL 1  &kp KP_N0      &kp KP_N1  &kp KP_N2   &kp KP_N3     &kp KP_PLUS      &kp C_AL_CALC  &trans  &kp F1  &kp F2  &trans  &trans   &trans  &trans
&bt BT_SEL 0  &out OUT_BLE   &kp KP_N0  &kp KP_DOT  &kp C_VOL_DN  &kp C_VOL_UP     &kp KP_NUM     &trans  &trans  &trans  &trans  &trans   &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans   &trans   &trans  &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &kp F11  &kp F12  &trans  &trans   &trans  &to 5
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F7   &kp F8   &kp F9  &kp F10  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F1   &kp F2   &kp F3  &kp F4   &kp F5  &kp F6
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &to 5   &trans   &trans   &trans  &trans   &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans                  &trans   &trans   &trans     &trans    &trans               &trans
&trans  &trans  &trans  &trans  &trans    &trans                  &trans   &trans   &trans     &trans    &middle_layer 4 MB3  &mkp MB2
&trans  &trans  &trans  &trans  &mkp MB1  &trans  &trans  &trans  &trans   &trans   &kp LC(C)  &mkp MB1  &mkp MB3             &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &kp LC(V)  &trans    &trans               &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &trans     &trans    &trans               &trans
            >;
        };
    };
};
